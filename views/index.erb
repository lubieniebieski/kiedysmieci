<section class="hero">
  <div class="hero-inner">
    <% if trash.next_trash_day.nil? %>
      <h1>Nie znaleziono danych o wywozie śmieci</h1>
      <p>Spróbuj odświeżyć stronę lub sprawdzić konfigurację.</p>
    <% else %>
      <h1>Następny wywóz śmieci będzie
        <span><%= I18n.t(:days, count: trash.next_trash_day.days_from_today) %></span>
      </h1>
      <h2>czyli
        <span><%= I18n.l(trash.next_trash_day.date, format: :longer) %></span>.</h2>
      <h2>
        ✅ Zbierane będą:
        <%= trash.next_trash_day %>
      </h2>

      <a href="<%= webcal_url %>" class="calendar-button">
        📅 Subskrybuj kalendarz
      </a>

      <hr/>

      <% if !trash.next_trash_day(1).nil? %>
        <h3>
          Kolejnym dniem wywozu śmieci będzie:
          <div>
            <span>
              <%= I18n.l(trash.next_trash_day(1).date, format: :longer) %>
            </span>
          </div>
          <div>Zbierane będą:
            <span>
              <%= trash.next_trash_day(1) %>
            </span>.
        </div>
      </h3>
    <% end %>
    <% end %>

  </div>
</section>
<footer class="footer">
  <p>Dane pochodzą ze strony
    <a href="https://selekt.czempin.pl/asp/pl_start.asp?typ=14&menu=13&strona=1">Centrum Zagospodarowania Odpadów - SELEKT</a>, ostatnia aktualizacja:
    <code><%= trash.last_updated_at %></code>
    (odświeżono:
    <code><%= cached_at %></code>).
  </p>
  Created with 💙 by
  <a href="https://lubieniebieski.pl">adam nowak</a>
</footer>
